{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "args": [
              "hook",
              "stop",
              "--agent",
              "claude"
            ],
            "command": "openspec-doc",
            "statusMessage": "Checking openspec-doc review feedback",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "hooks": [
          {
            "args": [
              "hook",
              "explore",
              "--agent",
              "claude"
            ],
            "command": "openspec-doc",
            "statusMessage": "Opening the openspec-doc exploration note",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "opsx:explore|openspec-explore"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "args": [
              "hook",
              "prompt",
              "--agent",
              "claude"
            ],
            "command": "openspec-doc",
            "statusMessage": "Checking openspec-doc review feedback",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ]
  }
}
