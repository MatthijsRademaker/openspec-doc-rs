{
  "name": "openspec-doc-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.2",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "e2e": "bun e2e/launch.ts",
    "test:e2e": "bun run e2e",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@lucide/vue": "^1.29.0",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "reka-ui": "^2.10.1",
    "shadcn-vue": "^2.8.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.41",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/vue": "8.1.0",
    "@types/node": "^26.1.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "2.4.11",
    "@vue/tsconfig": "^0.8.1",
    "jsdom": "30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "vite": "^7.3.6",
    "vitest": "4.1.10",
    "vue-tsc": "^3.3.9"
  }
}
